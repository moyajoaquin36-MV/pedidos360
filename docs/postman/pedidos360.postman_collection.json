          "name": "GET /api/kafka/topics",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const t = pm.response.json();",
                  "['pedidos-eventos', 'inventario-movimientos'].forEach(n => pm.test(n + ' con 3 particiones y 3 replicas', () => {",
                  "  const topico = t.find(x => x.nombre === n);",
                  "  pm.expect(topico.particiones).to.eql(3);",
                  "  pm.expect(topico.replicas).to.eql(3);",
                  "}));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/kafka/topics"
          }
        },
        {
          "name": "GET /api/kafka/topics/{nombre}",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json();",
                  "pm.test('Cada particion tiene lider y las 3 replicas sincronizadas (ISR)', () => d.particiones.forEach(p => {",
                  "  pm.expect(p.lider).to.not.be.null;",
                  "  pm.expect(p.isr).to.have.length(3);",
                  "}));",
                  "pm.test('Retencion por tiempo (cleanup.policy=delete)', () =>",
                  "  pm.expect(d.configs.find(x => x.nombre === 'cleanup.policy').valor).to.eql('delete'));"
                ]
              }
